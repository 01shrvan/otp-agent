{
  "baseUrl": "https://your-site.example",
  "signupUrl": "https://your-site.example/signup",
  "targetProfileUrl": "https://your-site.example/users/demo-account",
  "maxUsers": 3,
  "runDelayMs": 1500,
  "password": "TestPassword123!",
  "birthdate": "2000-01-01",
  "emailProvider": "mailosaur",
  "emailPrefix": "qa-follower",
  "otpRegex": "\\b\\d{4,8}\\b",
  "selectors": {
    "openAuthDialog": "button[data-auth='login'], button[data-testid='auth-trigger']",
    "authTab": "button:has-text('Sign Up')",
    "emailInput": "input[name='email'], input[name='emailOrUsername'], input[type='email']",
    "usernameInput": "input[name='username']",
    "birthdateInput": "input[name='birthdate'], input[type='date']",
    "passwordInput": "input[name='password'], input[type='password']",
    "submitAuth": "button[type='submit']",
    "otpInput": "input[name='otp'], input[autocomplete='one-time-code']",
    "submitOtp": "button[type='submit']",
    "followButton": "button:has-text('Follow')"
  }
}
